@page
@model EmployeeApp.Pages.Subject.CreateModel

@{
    ViewData["Title"] = "Create Subject";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">

            <h1>Create Subject</h1>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form method="post">

                <div class="mb-3">
                    <label asp-for="Subject.sub_name" class="form-label">
                        Subject Name
                    </label>

                    <input asp-for="Subject.sub_name"
                           class="form-control"
                           placeholder="Enter subject name" />

                    <span asp-validation-for="Subject.sub_name"
                          class="text-danger"></span>
                </div>


                <button type="submit" class="btn btn-primary">
                    Save
                </button>

                <a class="btn btn-danger" asp-page="Index">
                    Back
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}