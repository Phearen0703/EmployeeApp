@page
@using System.Globalization
@model EmployeeApp.Pages.Employees.IndexModel

@{
    ViewData["Title"] = "Employees";
    var us = new CultureInfo("en-US");
    var hasFilter = !string.IsNullOrWhiteSpace(Model.SearchString)
                    || Model.GenderId.HasValue || Model.LocationId.HasValue
                    || Model.StatusId.HasValue || Model.SubjectId.HasValue;
    var no = 0;
}

<div class="container-fluid mt-4">
 

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>NO</th>
                <th>Employee</th>
                <th>Subject</th>
                <th>Location</th>
                <th>Gender</th>
                <th class="text-end">Salary</th>
                <th>Date Hired</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Employees.Any())
            {
                <tr>
                    <td colspan="9" class="text-center">No employees found.</td>
                </tr>
            }

            @foreach (var item in Model.Employees)
            {
                no++;
                var subjects = string.Join(", ",
                    item.EmpSubs
                        .Where(x => x.Subject != null)
                        .OrderBy(x => x.Subject!.sort)
                        .Select(x => x.Subject!.sub_name));

                <tr>
                    <td>@no</td>
                    <td>@item.first_name @item.last_name</td>
                    <td>@subjects</td>
                    <td>@item.Location?.loc_name</td>
                    <td>@item.Gender?.gender</td>
                    <td class="text-end">@(item.salary?.ToString("C2", us))</td>
                    <td>@(item.date_hired?.ToString("dd-MM-yyyy"))</td>
                    <td>@item.Status?.status_name</td>
                </tr>
            }
        </tbody>
    </table>

</div>