@page "{id:int}"
@model EmployeeApp.Pages.Employees.DeleteModel

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">

            <h1>Delete Employee</h1>
            <h5 class="text-danger">Are you sure you want to delete this employee?</h5>

            <dl class="row">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.Employee.id</dd>

                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.Employee.first_name</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.Employee.last_name</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Employee.Gender?.gender</dd>

                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@Model.Employee.Location?.loc_name</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Employee.Status?.status_name</dd>

                <dt class="col-sm-4">Salary</dt>
                <dd class="col-sm-8">@Model.Employee.salary</dd>

                <dt class="col-sm-4">Date Hired</dt>
                <dd class="col-sm-8">@Model.Employee.date_hired?.ToString("yyyy-MM-dd")</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Employee.id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Back</a>
            </form>

        </div>
    </div>
</div>
