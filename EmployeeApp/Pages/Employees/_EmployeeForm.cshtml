@model EmployeeApp.Pages.Employees.EmployeeFormPageModel

<div class="mb-3">
    <label asp-for="Employee.first_name" class="form-label">First Name</label>
    <input asp-for="Employee.first_name" class="form-control" />
    <span asp-validation-for="Employee.first_name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Employee.last_name" class="form-label">Last Name</label>
    <input asp-for="Employee.last_name" class="form-control" />
    <span asp-validation-for="Employee.last_name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Employee.gender_id" class="form-label">Gender</label>
    <select asp-for="Employee.gender_id" asp-items="Model.Genders" class="form-select">
        <option value="">-- Select --</option>
    </select>
    <span asp-validation-for="Employee.gender_id" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Employee.location_id" class="form-label">Location</label>
    <select asp-for="Employee.location_id" asp-items="Model.Locations" class="form-select">
        <option value="">-- Select --</option>
    </select>
    <span asp-validation-for="Employee.location_id" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Employee.salary" class="form-label">Salary</label>
    <input asp-for="Employee.salary" type="number" step="0.01" class="form-control" />
    <span asp-validation-for="Employee.salary" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Employee.date_hired" class="form-label">Date Hired</label>
    <input asp-for="Employee.date_hired" type="date" class="form-control" />
    <span asp-validation-for="Employee.date_hired" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Employee.status_id" class="form-label">Status</label>
    <select asp-for="Employee.status_id" asp-items="Model.Statuses" class="form-select">
        <option value="">-- Select --</option>
    </select>
    <span asp-validation-for="Employee.status_id" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Subjects</label>
    <div class="border rounded p-2">
        @foreach (var s in Model.AllSubjects)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       id="subject_@s.id"
                       name="SelectedSubjectIds"
                       value="@s.id"
                       checked="@(Model.SelectedSubjectIds.Contains(s.id))" />
                <label class="form-check-label" for="subject_@s.id">@s.sub_name</label>
            </div>
        }

        @if (!Model.AllSubjects.Any())
        {
            <span class="text-muted">No subjects available.</span>
        }
    </div>
</div>
